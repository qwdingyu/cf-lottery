# ═══════════════════════════════════════════════════════════════
# cf-lottery 环境变量配置示例
# 复制此文件为 .env 并填写实际值，然后执行 bash local-deploy.sh
# ═══════════════════════════════════════════════════════════════

# ── 数据库（Turso/libSQL） ──
TURSO_URL=libsql://lottery-db-xxx.turso.io
TURSO_TOKEN=your_turso_token_here

# ── JWT 签名密钥（必填，生产环境请使用足够长的随机字符串） ──
JWT_SECRET=your-256-bit-jwt-secret-here

# ── 密码 pepper（推荐单独配置；未配置时后端会回退使用 JWT_SECRET） ──
PASSWORD_PEPPER=your-independent-password-pepper-here

# ── 邮件发送（Resend） ──
RESEND_API_KEY=re_xxx
EMAIL_FROM="抽奖平台 <noreply@yourdomain.com>"

# ── Cron 定时开奖认证密钥 ──
CRON_SECRET=your-cron-secret-here

# ── 敏感配置加密密钥（64 位 hex 字符串，用于加密切换配置） ──
CREDENTIALS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── Logto 身份认证（docs/051 方案） ─────────────────────
# Logto Cloud 租户端点，如 https://xxx.logto.app
LOGTO_ENDPOINT=
# Logto 应用 ID（SPA 应用）
LOGTO_APP_ID=

# ── 首个 L3 平台管理员初始化（本地执行，不暴露公开 bootstrap API） ──
# node scripts/bootstrap-platform-owner.mjs --email owner@example.com

# ── 站点域名（生产环境使用真实域名） ──
DOMAIN=lottery.example.com
# 或者直接指定 APP_ORIGIN（优先级高于 DOMAIN）
# APP_ORIGIN=https://lottery.example.com
