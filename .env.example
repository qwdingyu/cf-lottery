# ═══════════════════════════════════════════════════════════════
# cf-lottery 环境变量配置示例
# 复制此文件为 .env 并填写实际值，然后执行 bash local-deploy.sh
# ═══════════════════════════════════════════════════════════════

# ── 数据库（Turso/libSQL） ──
TURSO_URL=libsql://lottery-db-xxx.turso.io
TURSO_TOKEN=your_turso_token_here

# ── JWT 签名密钥（必填，生产环境请使用足够长的随机字符串） ──
JWT_SECRET=your-256-bit-jwt-secret-here

# ── 密码 pepper（推荐单独配置；未配置时后端会回退使用 JWT_SECRET） ──
PASSWORD_PEPPER=your-independent-password-pepper-here

# ── 邮件发送 ──
# 优先通道：cf-auth 邮件网关（docs/093）— OAuth client 认证，cf-auth 集中发送，零本地配置
# 在 https://auth.eforge.xyz/admin/clients 创建 OAuth App 并开启邮箱发送后填入。
# REMOTE_EMAIL_URL=https://auth.eforge.xyz/api/email/send
# REMOTE_EMAIL_CLIENT_ID=your-client-id
# REMOTE_EMAIL_CLIENT_SECRET=your-client-secret
#
# 回退通道：Resend（网关不可用时自动切换，留空则网关不通直接失败）
RESEND_API_KEY=re_xxx
EMAIL_FROM="抽奖平台 <noreply@yourdomain.com>"

# ── Cron 定时开奖认证密钥 ──
CRON_SECRET=your-cron-secret-here

# ── 敏感配置加密密钥（64 位 hex 字符串，用于加密切换配置） ──
CREDENTIALS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── 首个 L3 平台管理员初始化（本地执行，不暴露公开 bootstrap API） ──
# node scripts/bootstrap-platform-owner.mjs --email owner@example.com

# ── 站点域名（生产环境使用真实域名） ──
DOMAIN=lottery.example.com
# 或者直接指定 APP_ORIGIN（优先级高于 DOMAIN）
# APP_ORIGIN=https://lottery.example.com

# ── cf-auth OAuth RP（docs/059；统一认证 IdP，生产示例 https://auth.eforge.xyz） ──
# 开启后：GET /api/auth/cf-auth/meta + POST /api/auth/cf-auth/exchange
# 不共享 Better Auth cookie；不直连 auth 数据库；与邮箱码/用户名密码并存（已移除 Logto）
CF_AUTH_ENABLED=false
CF_AUTH_ISSUER=https://auth.eforge.xyz
CF_AUTH_CLIENT_ID=
CF_AUTH_CLIENT_SECRET=
CF_AUTH_REDIRECT_URI=https://lottery.example.com/auth/callback
# 本地联调可改：
# CF_AUTH_ISSUER=http://localhost:8788
# CF_AUTH_REDIRECT_URI=http://localhost:8787/auth/callback
# CF_AUTH_SCOPES=openid profile email
