{
  "name": "cf-lottery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "npm run frontend:build && npx wrangler deploy",
    "deps:ci": "npm ci",
    "type-check": "tsc --noEmit",
    "type-check:frontend": "npm --workspace frontend run type-check",
    "type-check:all": "npm run type-check && npm run type-check:frontend",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:lottery": "node scripts/04-smoke-lottery.mjs",
    "frontend:build": "npm --workspace frontend run build",
    "db:generate": "npx drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:studio": "npx drizzle-kit studio",
    "verify:delivery": "npm run type-check && npm run test && npm run frontend:build"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "drizzle-orm": "0.45.2",
    "hono": "^4.12.22"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260726.1",
    "@vitest/coverage-v8": "4.1.7",
    "drizzle-kit": "^0.30.0",
    "typescript": "5.7.3",
    "vite": "6.4.3",
    "vitest": "4.1.7",
    "wrangler": "4.114.0"
  }
}
