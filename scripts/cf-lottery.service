[Unit]
Description=cf-lottery Hono Server
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/cf-lottery
EnvironmentFile=/opt/cf-lottery/.env
# 使用 esbuild 打包后的产物运行（无需 tsx 运行时转译，启动更快、部署更稳）
# 对比结论见 docs/191 §5.2 和 docs/156 §七
# node_modules 由部署流程手动 `npm install --omit=dev` 安装（无 ExecStartPre，避免重启时自动安装）
ExecStart=/usr/bin/node /opt/cf-lottery/dist/server.js
Restart=always
RestartSec=5

# 安全加固（ProtectSystem=full 允许 /usr/bin/node 运行）
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/opt/cf-lottery/data /opt/cf-lottery/node_modules/.cache

# 健康检查（每 30 秒）
HealthCmd=/usr/bin/curl -sf http://localhost:8787/api/health

[Install]
WantedBy=multi-user.target
