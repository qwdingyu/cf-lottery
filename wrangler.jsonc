{
  // 项目名称
  "name": "cf-lottery",

  // Worker 入口文件
  "main": "src/index.ts",

  // 兼容性日期
  "compatibility_date": "2026-05-24",

  // 自定义域名路由
  "routes": [
    { "pattern": "lucky.eforge.xyz", "custom_domain": true }
  ],

  // 静态资源配置
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },

  // 可观测性
  "observability": {
    "enabled": true
  },

  // Cron 定时开奖
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  // 非敏感环境变量
  "vars": {
    "APP_ORIGIN": "https://lucky.eforge.xyz"
  },

  // ═══════════════════════════════════════════════════════════════
  // 必需 secrets（由 wrangler secret put 设置）
  // ═══════════════════════════════════════════════════════════════
}