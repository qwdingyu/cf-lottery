{
  // 项目名称
  "name": "cf-lottery",

  // Worker 入口文件
  "main": "src/index.ts",

  // 兼容性日期
  "compatibility_date": "2026-05-24",

  // docs/259 P0-1：开启 nodejs_compat（CF 构建必需）
  // - local-media.ts 静态导入 node:fs/promises / node:path，wrangler 无此 flag 仅告警、启动即抛；
  // - incentive-engine 包根模块级 require("crypto")，无此 flag 时 esbuild 直接解析失败。
  //   注意：不得用「深导入 src/engine/distribute」替代——该路径导出无 Distribute 嵌套层，
  //   调用点 engine.Distribute.distributeByDefs 运行时 TypeError 且被 try/catch 吞掉，
  //   全部邀请奖励静默失效（docs/259 第二版修订确认）。
  "compatibility_flags": ["nodejs_compat"],

  // 自定义域名路由
  "routes": [
    { "pattern": "lucky.eforge.xyz", "custom_domain": true }
  ],

  // 静态资源配置
  // SPA 模式：not_found_handling 将不存在的路径回退到 index.html，Vue Router 接管路由。
  // run_worker_first 只让 API 路径进 Worker，静态资源（JS/CSS/字体/图片）走 Cloudflare 资产网络，
  // 不消耗 Workers Free 的 100,000 requests/day 额度。
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // 可观测性
  "observability": {
    "enabled": true
  },

  // Cron 定时开奖
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  // R2 图片存储：奖品图、活动海报等媒体文件。
  // 当前沿用 cf-shop 的 R2 bucket（cf-shop-public-media），统一管理跨项目静态资源。
  "r2_buckets": [
    {
      "binding": "LOTTERY_MEDIA",
      "bucket_name": "cf-shop-public-media"
    }
  ],

  // 非敏感环境变量（CF_AUTH 开关与 URL；CLIENT_ID/SECRET 走 secrets）
  "vars": {
    "APP_ORIGIN": "https://lucky.eforge.xyz",
    "CF_AUTH_ENABLED": "true",
    "CF_AUTH_ISSUER": "https://auth.eforge.xyz",
    "CF_AUTH_REDIRECT_URI": "https://lucky.eforge.xyz/auth/callback",
    "CF_AUTH_SCOPES": "openid profile email"
  }

  // secrets（wrangler secret put，勿写入本文件）：
  // TURSO_URL / TURSO_TOKEN / JWT_SECRET / RESEND_* / CRON_SECRET
  // CF_AUTH_CLIENT_ID / CF_AUTH_CLIENT_SECRET
  // 可选清理遗留：LOGTO_APP_ID / LOGTO_ENDPOINT
}
