{
  // 项目名称
  "name": "cf-lottery",

  // Worker 入口文件
  "main": "src/index.ts",

  // 兼容性日期
  "compatibility_date": "2026-05-24",

  // 自定义域名路由
  "routes": [
    { "pattern": "lucky.eforge.xyz", "custom_domain": true }
  ],

  // 静态资源配置
  // SPA 模式：not_found_handling 将不存在的路径回退到 index.html，Vue Router 接管路由。
  // run_worker_first 只让 API 路径进 Worker，静态资源（JS/CSS/字体/图片）走 Cloudflare 资产网络，
  // 不消耗 Workers Free 的 100,000 requests/day 额度。
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // 可观测性
  "observability": {
    "enabled": true
  },

  // Cron 定时开奖
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  // R2 图片存储：奖品图、活动海报等媒体文件。
  // 当前沿用 cf-shop 的 R2 bucket（cf-shop-public-media），统一管理跨项目静态资源。
  "r2_buckets": [
    {
      "binding": "LOTTERY_MEDIA",
      "bucket_name": "cf-shop-public-media"
    }
  ],

  // 非敏感环境变量
  "vars": {
    "APP_ORIGIN": "https://lucky.eforge.xyz"
  },

  // ═══════════════════════════════════════════════════════════════
  // 必需 secrets（由 wrangler secret put 设置）
  // ═══════════════════════════════════════════════════════════════
}
