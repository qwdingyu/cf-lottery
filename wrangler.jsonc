{
  // 项目名称 — 部署后自动生成 <name>.workers.dev 域名
  "name": "cf-lottery",

  // Worker 入口文件
  "main": "src/index.ts",

  // 兼容性日期 — 锁定 Workers 运行时 API 版本
  "compatibility_date": "2026-05-24",

  // 静态资源配置（Cloudflare Assets）
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },

  // 可观测性（日志 + 指标）
  "observability": {
    "enabled": true
  },

  // 抽奖到期兜底开奖：每 5 分钟执行一次，每次最多处理 20 个活动
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  // 非敏感环境变量
  "vars": {
    "APP_ORIGIN": "https://cj.eforge.xyz"
  },

  // ═══════════════════════════════════════════════════════════════
  // 必需 secrets（由 wrangler secret put 设置）：
  //
  //   TURSO_URL                      — 数据库连接 URL
  //   TURSO_TOKEN                    — 数据库认证 Token
  //   JWT_SECRET                     — JWT 签名密钥
  //   RESEND_API_KEY                 — 邮件发送 API Key
  //   EMAIL_FROM                     — 发件邮箱地址
  //   CRON_SECRET                    — Cron 定时开奖认证密钥
  //   CREDENTIALS_ENCRYPTION_KEY     — 敏感配置加密密钥（64 位 hex）
  //
  // 本地开发时写入 .dev.vars 文件（已加入 .gitignore）
  // ═══════════════════════════════════════════════════════════════
}