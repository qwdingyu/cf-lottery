[
  {
    "key": "platform_name",
    "label": "平台名称",
    "description": "管理后台和公开页展示的平台品牌名称。",
    "effect": "前端 AdminLayout 品牌标识和页脚展示，未配置时使用默认值。",
    "scope": "public",
    "type": "string",
    "defaultValue": "抽奖平台",
    "maxLength": 40,
    "group": "基础信息",
    "order": 1,
    "difficulty": "basic"
  },
  {
    "key": "support_email",
    "label": "客服邮箱",
    "description": "公开页展示的客服联系邮箱。",
    "effect": "前端页脚展示，参与者可通过此邮箱联系客服。",
    "scope": "public",
    "type": "string",
    "defaultValue": "",
    "format": "email",
    "maxLength": 120,
    "group": "基础信息",
    "order": 2,
    "difficulty": "basic"
  },
  {
    "key": "email_from_name",
    "label": "发件人名称",
    "description": "邮件通知中显示的发件人名称。",
    "effect": "中奖通知和验证码邮件的发件人名称，未配置时使用平台名称。",
    "scope": "admin",
    "type": "string",
    "defaultValue": "抽奖平台",
    "maxLength": 60,
    "group": "邮件通知",
    "order": 3,
    "difficulty": "basic"
  },
  {
    "key": "draw_default_winner_count",
    "label": "默认中奖名额",
    "description": "创建活动时默认的中奖人数。",
    "effect": "创建活动表单的默认值，运营者可按活动单独调整。",
    "scope": "admin",
    "type": "integer",
    "defaultValue": "1",
    "min": 1,
    "max": 9999,
    "group": "抽奖设置",
    "order": 4,
    "difficulty": "basic"
  },
  {
    "key": "draw_max_participants",
    "label": "单活动最大参与人数",
    "description": "单个活动允许的最大参与人数上限，0 表示不限制。",
    "effect": "创建活动时校验，超过此限制则拒绝新参与者加入。",
    "scope": "admin",
    "type": "integer",
    "defaultValue": "0",
    "min": 0,
    "max": 999999,
    "group": "抽奖设置",
    "order": 5,
    "difficulty": "basic"
  },
  {
    "key": "draw_max_duration_days",
    "label": "活动最长持续时间（天）",
    "description": "单个活动允许的最长持续天数，防止运营者设置超长活动。",
    "effect": "创建活动时校验，超过此限制则拒绝创建。",
    "scope": "admin",
    "type": "integer",
    "defaultValue": "90",
    "min": 1,
    "max": 365,
    "group": "抽奖设置",
    "order": 6,
    "difficulty": "basic"
  },
  {
    "key": "access_code_expires_seconds",
    "label": "验证码有效期（秒）",
    "description": "邮箱验证码的有效期，超时后需重新获取。",
    "effect": "发送验证码时设置有效期，参与者需在有效期内完成验证。",
    "scope": "admin",
    "type": "integer",
    "defaultValue": "600",
    "min": 60,
    "max": 3600,
    "group": "安全设置",
    "order": 7,
    "difficulty": "basic"
  },
  {
    "key": "rate_limit_access_code",
    "label": "验证码发送频率限制",
    "description": "同一邮箱每小时最多可请求验证码的次数，防止滥用。",
    "effect": "发送验证码时校验，超过限制则拒绝发送。",
    "scope": "admin",
    "type": "integer",
    "defaultValue": "5",
    "min": 1,
    "max": 100,
    "group": "安全设置",
    "order": 8,
    "difficulty": "basic"
  },
  {
    "key": "rate_limit_login",
    "label": "登录频率限制",
    "description": "同一 IP 每小时最多可尝试登录的次数。",
    "effect": "登录时校验，超过限制则临时拒绝登录。",
    "scope": "admin",
    "type": "integer",
    "defaultValue": "10",
    "min": 1,
    "max": 100,
    "group": "安全设置",
    "order": 9,
    "difficulty": "basic"
  },
  {
    "key": "data_retention_days",
    "label": "数据保留天数",
    "description": "审计日志和过期活动的保留天数，超过此期限的旧数据可被清理。",
    "effect": "定时清理任务根据此配置删除过期数据。",
    "scope": "admin",
    "type": "integer",
    "defaultValue": "365",
    "min": 30,
    "max": 3650,
    "group": "数据维护",
    "order": 10,
    "difficulty": "advanced"
  },
  {
    "key": "audit_log_retention_days",
    "label": "审计日志保留天数",
    "description": "审计日志的单独保留天数，通常应长于数据保留天数。",
    "effect": "定时清理任务根据此配置删除过期审计日志。",
    "scope": "admin",
    "type": "integer",
    "defaultValue": "730",
    "min": 30,
    "max": 3650,
    "group": "数据维护",
    "order": 11,
    "difficulty": "advanced"
  },
