    "enum": ["open","registered","roster","password","invite_code"],
    "enumLabels": {"open":"公开参与","registered":"需注册登录","roster":"限定名单","password":"访问密码","invite_code":"邀请码"}
  },
  {
    "key": "enable_registration",
    "label": "开放注册",
    "description": "是否允许新用户自助注册。关闭后仅平台运营者可通过后台创建租户。",
    "effect": "注册接口校验，关闭时新用户无法注册。已有用户不受影响。",
    "scope": "admin",
    "type": "boolean",
    "defaultValue": "true",
    "group": "平台运营",
    "order": 21,
    "difficulty": "basic"
  },
  {
    "key": "free_plan_max_webhooks",
    "label": "Free 套餐 Webhook 数量",
    "description": "Free 套餐的租户最多可配置的 Webhook 数量。MVP 推广期建议设为 1，给用户试用体验。",
    "effect": "创建 Webhook 时校验，超过此限制则拒绝。",
    "scope": "admin",
    "type": "integer",
    "defaultValue": "1",
    "min": 0,
    "max": 100,
    "group": "套餐额度",
    "order": 22,
    "difficulty": "advanced"
  },
  {
    "key": "enable_pricing_page",
    "label": "显示套餐页",
    "description": "是否在前端展示套餐定价页。MVP 推广期建议关闭，避免用户因价格劝退。",
    "effect": "前端根据此配置决定是否展示定价入口。",
    "scope": "admin",
    "type": "boolean",
    "defaultValue": "false",
    "group": "平台运营",
    "order": 23,
    "difficulty": "basic"
  },
  {
    "key": "marketing_draw_reminder_enabled",
    "label": "开奖提醒邮件",
    "description": "是否在开奖前向参与者发送提醒邮件。关闭后不再发送任何开奖提醒。",
    "effect": "Cron 定时任务扫描到期活动时，根据此开关决定是否发送提醒邮件。",
    "scope": "admin",
    "type": "boolean",
    "defaultValue": "false",
    "group": "营销邮件",
    "order": 1,
    "difficulty": "basic"
  },
  {
    "key": "marketing_draw_reminder_minutes",
    "label": "开奖提醒提前分钟数",
    "description": "在开奖前多少分钟发送提醒邮件。例如 60 表示开奖前 1 小时发送。建议 30-120 分钟。",
    "effect": "Cron 扫描时以此值为中心 ±5 分钟窗口，匹配到期的开奖活动发送提醒。",
    "scope": "admin",
    "type": "integer",
    "defaultValue": "60",
    "min": 5,
    "max": 1440,
    "group": "营销邮件",
    "order": 2,
    "difficulty": "advanced"
  },
  {
    "key": "marketing_loser_consolation_enabled",
    "label": "未中奖安慰邮件",
    "description": "是否在开奖后向未中奖用户发送安慰邮件（含优惠券信息）。需要先配置未中奖发券功能。",
    "effect": "开奖完成后发券时，根据此开关决定是否额外发送安慰邮件。",
    "scope": "admin",
    "type": "boolean",
    "defaultValue": "false",
    "group": "营销邮件",
    "order": 3,
    "difficulty": "basic"
  },
  {
    "key": "notify_winner_email_enabled",
    "label": "中奖通知邮件",
    "description": "是否在开奖后向中奖者发送邮件通知。关闭后中奖者不会收到邮件，但仍可在公开页查询结果。",
    "effect": "开奖完成后根据此开关决定是否发送中奖通知邮件。关闭不影响中奖记录写入和 Webhook 推送。",
    "scope": "admin",
    "type": "boolean",
    "defaultValue": "true",
    "group": "营销邮件",
    "order": 4,
    "difficulty": "basic"
  },
  {
    "key": "rate_limit_join_per_minute",
    "label": "参与限流（次/分钟）",
    "description": "同一 IP 每分钟最多可参与次数。过高可能被刷量，过低影响正常用户。建议 5-20。",
    "effect": "公开活动参与接口（/join 和 /verify-join）的 IP 限流阈值。",
    "scope": "admin",
    "type": "integer",
    "defaultValue": "10",
    "min": 1,
    "max": 100,
    "group": "安全与验证",
    "order": 30,
    "difficulty": "basic"
  },
  {
    "key": "dashboard_roi_days",
    "label": "ROI 统计天数",
    "description": "管理后台仪表盘展示近 N 天的转化数据。例如 30 表示展示近 30 天的 GMV 和转化数。",
    "effect": "Dashboard ROI 汇总查询的时间窗口，影响 GMV 和转化率的展示范围。",
    "scope": "admin",
    "type": "integer",
    "defaultValue": "30",
    "min": 1,
    "max": 365,
    "group": "平台运营",
    "order": 26,
    "difficulty": "advanced"
  },
  {
    "key": "enable_email_verification",
    "label": "邮箱验证码",
    "description": "是否启用邮箱验证码参与流程。关闭后参与者输入邮箱即可直接参与，不发送验证码邮件。仅建议 Resend 不可用 / 测试环境时关闭，生产环境务必开启。",
    "effect": "关闭时 access-code 端点跳过邮件发送，直接写入参与记录。",
    "scope": "admin",
    "type": "boolean",
    "defaultValue": "true",
    "group": "安全设置",
    "order": 31,
    "difficulty": "advanced"
  }
